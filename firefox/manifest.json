{
  "manifest_version": 3,
  "name": "Tab Labels",
  "version": "1.7.0",
  "description": "Tag tabs with coloured labels from the tab right-click menu. Local only, no data leaves Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-labels@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["menus", "tabs", "storage", "sessions", "contextualIdentities", "cookies", "scripting", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["lib/labels.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/labels.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
